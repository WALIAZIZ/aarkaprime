# Database (PostgreSQL connection string)
# For Vercel: set this in Vercel dashboard → Settings → Environment Variables
# For Neon: postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/estateiq

# DeepSeek AI (get your key at https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-api-key-here

# NextAuth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=https://your-app.vercel.app
